# Only run this file for interactive shells
[[ -o interactive ]] || return

# Brew shellenv (Linux, macOS ARM, macOS Intel)
for _brew in /home/linuxbrew/.linuxbrew/bin/brew /opt/homebrew/bin/brew /usr/local/bin/brew; do
  if [[ -x "$_brew" ]]; then
    eval "$("$_brew" shellenv)"
    break
  fi
done
unset _brew

# Cache brew prefix
# `brew shellenv` above already exported HOMEBREW_PREFIX, so asking brew again
# would fork a process for a value we already have.
#
# If the loop found no brew, say so rather than carrying an empty prefix into
# fpath and the plugin paths below — but keep going. ${VAR:?} would abort the
# rest of this file, and a half-sourced rc (no aliases, no PATH, no vi mode) is
# a worse shell than one missing its completions.
BREW_PREFIX="$HOMEBREW_PREFIX"
[[ -n $BREW_PREFIX ]] ||
  print -u2 "zshrc: no brew found — completions and the zsh plugins will fail to load"

# Don't let Ctrl-S freeze the terminal
stty -ixon

# fzf default command
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border'

## Completion setup
# Nothing to generate by hand. Every completion in site-functions is a symlink
# brew maintains into the Cellar, so they follow their formula on upgrade. This
# used to carry `chezmoi completion zsh > .../_chezmoi` and the same for just,
# to be run once — but writing a plain file over brew's symlink replaces a
# self-updating completion with one frozen at the version it was generated from.

# 1. fpath first
# -U for the same reason as `path` further down. Two things add this directory:
# `brew shellenv` above and the line below. That alone is two copies, measured
# from a clean environment with this line removed. It is three in any shell
# started from another one, because brew shellenv *exports* FPATH, so the child
# inherits the entry and then both writers add it again — which is the common
# case here, every shell being a tmux pane. Each further level of nesting adds
# one more. compinit walks every copy. Declared before the assignment so that
# one is deduped too.
typeset -U fpath
fpath=("$BREW_PREFIX/share/zsh/site-functions" $fpath)

# 2. compinit with 24hr cache
# The staleness test is a glob qualifier rather than a find(1) fork: N is
# nullglob so a missing dump matches nothing, . restricts to plain files, and
# mh+24 is "modified more than 24 hours ago".
autoload -Uz compinit
_zcompdump_stale=("$HOME"/.zcompdump(N.mh+24))
if (( $#_zcompdump_stale )); then
  compinit -u -d "$HOME/.zcompdump"
else
  compinit -C -u -d "$HOME/.zcompdump"
fi
unset _zcompdump_stale

# 3. fzf shell integration
source <(fzf --zsh)

# 4. fzf-tab — every TAB completion goes through fzf, not just the ** trigger.
#
# Wedged between fzf and zsh-autosuggestions because both neighbours constrain
# it. It has to be the *last* plugin to bind ^I: fzf's integration above binds
# ^I to fzf-completion, and fzf-tab calls whatever it finds there to produce the
# candidate list. It also has to load *before* anything that wraps widgets,
# which zsh-autosuggestions does. compinit has already run above. Move it out of
# this gap in either direction and it stops working, quietly.
source "$BREW_PREFIX/share/fzf-tab/fzf-tab.zsh"

# `menu no` is required rather than cosmetic: zsh's own completion menu would
# consume the unambiguous prefix before fzf-tab could see it.
zstyle ':completion:*' menu no
zstyle ':completion:*:descriptions' format '[%d]'
# LS_COLORS is unset on macOS unless something exports it; this then yields an
# empty colour list, which is harmless — candidates are simply uncoloured.
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}

# Preview the directory a completion refers to, using the eza the ls aliases use.
# just's completion is replaced outright. clap's dynamic completer offers every
# recipe, every global flag, every variable, and every file and directory in the
# cwd — and splits them across two `_describe` calls, one for directories and one
# for everything else. Three problems follow, and only the third needs this much:
#
#   1. ~40 flags sort ahead of the recipes, pushing them off the screen.
#   2. Files and directories are offered as first arguments, which is noise.
#   3. A name that is both a recipe and a directory — docs, bench, config, slides
#      across six of these projects — is emitted by *both* calls and so appears
#      twice.
#
# The first two yield to `ignored-patterns`, which is where this started. The
# third does not: ignored-patterns matches the candidate *value*, and the two
# `docs` entries are the same string, so any pattern hiding one hides both. That
# was tried, and it silently removed the docs recipe.
#
# So take clap's data — its output is `name:description` lines, which is the
# stable part — filter it, and describe it once. `just --summary` is the
# authority on what is a recipe. A leading `-` switches to the flags instead, so
# `just --su<TAB>` still completes. Returning 1 when there is no justfile lets
# zsh fall back as usual.
_just_recipes_only() {
  local -a cands recipes out
  local c name desc nl cur
  nl=$'\n'
  cur=${words[CURRENT]}

  recipes=(${(z)"$(just --summary 2>/dev/null)"})
  (( $#recipes )) || return 1

  cands=(${(f)"$(_CLAP_IFS=$nl _CLAP_COMPLETE_INDEX=$((CURRENT - 1)) JUST_COMPLETE=zsh just -- "${words[@]}" 2>/dev/null)"})

  # Only the first argument is narrowed to recipes. Past that, a recipe's own
  # parameters are in play and several of them take paths — pf2e-prep's
  # `reindex file:` is documented as `just reindex campaign/npcs/wrin.md` — so
  # everything clap offers is passed through, minus the flags. Filtering there
  # too was the first version of this and silently removed file completion for
  # every parameterised recipe.
  for c in $cands; do
    name=${c%%:*}
    if [[ $c == *:* ]]; then desc=${c#*:}; else desc=''; fi
    if [[ $cur == -* ]]; then
      [[ $name == -* ]] && out+=("${name}${desc:+:$desc}")
    elif (( CURRENT > 2 )); then
      [[ $name != -* ]] && out+=("${name}${desc:+:$desc}")
    else
      (( ${recipes[(I)$name]} )) && out+=("${name}${desc:+:$desc}")
    fi
  done

  (( $#out )) || return 1
  if [[ $cur == -* ]]; then
    _describe -t options 'option' out
  elif (( CURRENT > 2 )); then
    _describe -t arguments 'argument' out
  else
    _describe -t recipes 'recipe' out
  fi
}
compdef _just_recipes_only just
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --icons --color=always $realpath'
zstyle ':fzf-tab:complete:__zoxide_z:*' fzf-preview 'eza -1 --icons --color=always $realpath'

# Options
# No COMPLETE_ALIASES: it stops an alias being expanded before completion, so
# `ll --<TAB>` offered nothing where eza's own flags were wanted. No
# APPEND_HISTORY either, but not because SHARE_HISTORY implies it — it is on by
# default (`zsh -f` reports it on), so setting it would restate a default. What
# SHARE_HISTORY documents implying is INC_APPEND_HISTORY, which the manual says
# should be turned *off* while SHARE_HISTORY is in effect; measured off here.
setopt SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_SAVE_NO_DUPS HIST_IGNORE_SPACE

# History
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000

# Plugins
# Sourced unguarded on purpose. The guarded form failed *silently*: a missing
# plugin meant no autosuggestions and no explanation for it. The tool evals
# below — fzf, starship, zoxide, direnv — already fail loudly, so this matches
# them.
source "$BREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"

# Prompt
# Guarded so it runs once per shell *process*, not once per source. Starship's
# init preserves any existing zle-keymap-select widget and wraps it, to redraw
# the prompt when the vi mode changes. Sourced a third time that wrapping eats
# itself: the second run leaves the widget as starship_zle-keymap-select-wrapped,
# so the third preserves *that* name and then redefines the function under it to
# call the preserved name — i.e. itself. The result is
#
#     starship_zle-keymap-select-wrapped:1: maximum nested function level
#     reached; increase FUNCNEST?
#
# on every Esc, once `source ~/.zshrc` has been run three times in one shell.
# The flag is deliberately not exported: a nested shell is a new process and must
# initialise starship itself, which an exported guard (STARSHIP_SHELL is the
# obvious candidate) would wrongly suppress.
if [[ -z "${_STARSHIP_INIT_DONE:-}" ]]; then
    eval "$(starship init zsh)"
    typeset -g _STARSHIP_INIT_DONE=1
fi

export EDITOR=nvim
export VISUAL=nvim

# zk (Zettelkasten notebook) — lets zk commands run from anywhere
export ZK_NOTEBOOK_DIR="$HOME/notes"

# Aliases
alias ls='eza --group-directories-first --icons=auto'
alias ll='eza -lh --git'
alias la='eza -lha'

# yazi, with the shell following it out. `q` writes the directory you ended in
# to --cwd-file and this cd's there; `Q` quits without writing, so the shell
# stays where it was. Upstream's own wrapper, from
# https://yazi-rs.github.io/docs/quick-start, kept verbatim except for the name.
#
# Named `yazi_lastdir` rather than upstream's `y`, so the function itself says
# what it does, and reached by two aliases. `yazi`, so following the cwd is the
# default rather than something you have to remember to ask for; and `y`,
# because zoxide already owns `z` here and the two are the same verb — `z`
# jumps when you know where you are going, `y` browses when you do not. A
# single letter is not a new pattern in this shell, it is the established one.
#
# Not `ya`, the obvious two-letter form: that is yazi's own package manager,
# the `ya pkg install` that bootstrap.sh runs and that pins the flavor.
#
# `command yazi` is load-bearing, and more so here than upstream: it bypasses
# both the alias and this function, so `yazi` -> alias -> yazi_lastdir ->
# command yazi -> the binary terminates. A plain alias expands only in command
# position and the `yazi` after `command` is an argument, so this holds
# whichever order the alias and the function are written in — measured both.
#
# Drop the `command` and the safety becomes accidental and order-dependent,
# which is worse than broken. zsh expands aliases when it *parses* a function
# body, so with the alias below the function — the order here — a bare `yazi`
# inside is still literal and happens to work. Move the alias above and the
# same code dies with "maximum nested function level reached". Also measured,
# both ways.
#
# Aliases exist only in interactive shells, so bootstrap.sh and anything else
# that runs yazi from a script still gets the binary.
yazi_lastdir() {
  local tmp cwd
  tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
  command yazi "$@" --cwd-file="$tmp"
  IFS= read -r -d '' cwd < "$tmp"
  [ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd" || builtin true
  command rm -f -- "$tmp"
}
alias yazi=yazi_lastdir
alias y=yazi_lastdir

# broot's `br`, which is the same trick one tool over. broot writes the command
# it wants the shell to run — a `cd`, almost always — to a file, and the
# function evals it, because a subshell cannot change your directory.
# `yazi_lastdir` above reaches the same end through `--cwd-file`.
#
# Sourced rather than copied in: broot generates the launcher itself
# (`broot --install`) and rewrites it on upgrade, so a copy here would go stale
# without saying so. Tracking the `source` line is the whole of what is needed.
#
# It got here by broot appending that line to ~/.zshrc during install, which is
# the behaviour bootstrap.sh denies rustup with --no-modify-path. Tracked now so
# the two writers agree and `chezmoi apply` stops wanting to delete it.
#
# Guarded on the launcher file rather than on the binary, and XDG rather than a
# literal path: the Linux machine may have neither, and sourcing a file that is
# not there is an error on every new shell, not a quiet no-op.
_broot_launcher="${XDG_CONFIG_HOME:-$HOME/.config}/broot/launcher/bash/br"
[[ -r "$_broot_launcher" ]] && source "$_broot_launcher"
unset _broot_launcher

# Zoxide
eval "$(zoxide init zsh)"

# Vi mode
bindkey -v
export KEYTIMEOUT=10
bindkey '^P' history-search-backward
bindkey '^N' history-search-forward
bindkey '^Y' autosuggest-accept

# Atuin — SQLite-backed history, replacing fzf's C-r. Records cwd, exit code and
# duration per command, which is what makes `--cwd .` and `--exit 0` possible;
# a flat HISTFILE has nowhere to put them.
#
# Placed here because it has to come after all three of:
#   * fzf, which binds C-r above — atuin must run later to take it.
#   * zsh-autosuggestions, which must already have set ZSH_AUTOSUGGEST_STRATEGY.
#     atuin *prepends* itself, so sourced first it becomes ("atuin") alone and
#     silently drops the history fallback instead of ("atuin" "history").
#   * bindkey -v, so the keymaps it binds into are the ones in use.
#
# --disable-ai drops `bindkey '?' self-atuin-ai-question-mark`, which atuin emits
# with no -M and so lands in whatever keymap is current — viins here. It does
# fall through to self-insert, but rebinding a bare `?` in insert mode is not a
# risk worth carrying for a feature this config does not use.
eval "$(atuin init zsh --disable-ai)"

# Give vi normal mode back its two motions. atuin binds vicmd `k` to its search
# UI — unconditionally, unless the buffer is multi-line — and vicmd `/` likewise,
# which leaves normal mode unable to move up a line or start a search. That is
# broken vi rather than a different history tool, and C-r and Up already reach
# atuin from insert mode, which is where the feature actually lives.
# Delete these two lines to run atuin's stock bindings.
bindkey -M vicmd 'k' up-line-or-history
bindkey -M vicmd '/' vi-history-search-backward

# use direnv for automatic .env loading
eval "$(direnv hook zsh)"

# zsh-syntax-highlighting (must be last)
source "$BREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

# Setup personal path
# ~/.cargo/bin is here because bootstrap.sh installs rustup with
# --no-modify-path, which is deliberate — rustup would otherwise edit .zshrc
# itself — but it means nothing else adds the directory. Without this line the
# whole toolchain installs and then cannot be found: cargo, rustc, rustfmt and
# rust-analyzer all sit in ~/.cargo/bin unreachable, and nvim inherits the same
# empty PATH, so a .rs file gets no LSP and no formatter.
path=($HOME/.local/bin $HOME/.cargo/bin $HOME/bin $path)
typeset -U path   # dedupe, keeps first occurrence, repeated sourcing .zshrc won't stack
