# Only run this file for interactive shells
[[ -o interactive ]] || return

# Brew shellenv (Linux, macOS ARM, macOS Intel)
for _brew in /home/linuxbrew/.linuxbrew/bin/brew /opt/homebrew/bin/brew /usr/local/bin/brew; do
  if [[ -x "$_brew" ]]; then
    eval "$("$_brew" shellenv)"
    break
  fi
done
unset _brew

# Cache brew prefix
# `brew shellenv` above already exported HOMEBREW_PREFIX, so asking brew again
# would fork a process for a value we already have.
#
# If the loop found no brew, say so rather than carrying an empty prefix into
# fpath and the plugin paths below — but keep going. ${VAR:?} would abort the
# rest of this file, and a half-sourced rc (no aliases, no PATH, no vi mode) is
# a worse shell than one missing its completions.
BREW_PREFIX="$HOMEBREW_PREFIX"
[[ -n $BREW_PREFIX ]] ||
  print -u2 "zshrc: no brew found — completions and the zsh plugins will fail to load"

# Don't let Ctrl-S freeze the terminal
stty -ixon

# fzf default command
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border'

## Completion setup
# Nothing to generate by hand. Every completion in site-functions is a symlink
# brew maintains into the Cellar, so they follow their formula on upgrade. This
# used to carry `chezmoi completion zsh > .../_chezmoi` and the same for just,
# to be run once — but writing a plain file over brew's symlink replaces a
# self-updating completion with one frozen at the version it was generated from.

# 1. fpath first
# -U for the same reason as `path` further down: this directory is added by
# /etc/zshrc, by brew shellenv and by kitty's shell integration as well as here,
# so without it fpath carried six copies of site-functions and compinit walked
# each one. Declared before the assignment so that one is deduped too.
typeset -U fpath
fpath=("$BREW_PREFIX/share/zsh/site-functions" $fpath)

# 2. compinit with 24hr cache
# The staleness test is a glob qualifier rather than a find(1) fork: N is
# nullglob so a missing dump matches nothing, . restricts to plain files, and
# mh+24 is "modified more than 24 hours ago".
autoload -Uz compinit
_zcompdump_stale=("$HOME"/.zcompdump(N.mh+24))
if (( $#_zcompdump_stale )); then
  compinit -u -d "$HOME/.zcompdump"
else
  compinit -C -u -d "$HOME/.zcompdump"
fi
unset _zcompdump_stale

# 3. fzf shell integration
source <(fzf --zsh)

# 4. fzf-tab — every TAB completion goes through fzf, not just the ** trigger.
#
# Wedged between fzf and zsh-autosuggestions because both neighbours constrain
# it. It has to be the *last* plugin to bind ^I: fzf's integration above binds
# ^I to fzf-completion, and fzf-tab calls whatever it finds there to produce the
# candidate list. It also has to load *before* anything that wraps widgets,
# which zsh-autosuggestions does. compinit has already run above. Move it out of
# this gap in either direction and it stops working, quietly.
source "$BREW_PREFIX/share/fzf-tab/fzf-tab.zsh"

# `menu no` is required rather than cosmetic: zsh's own completion menu would
# consume the unambiguous prefix before fzf-tab could see it.
zstyle ':completion:*' menu no
zstyle ':completion:*:descriptions' format '[%d]'
# LS_COLORS is unset on macOS unless something exports it; this then yields an
# empty colour list, which is harmless — candidates are simply uncoloured.
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}

# Preview the directory a completion refers to, using the eza the ls aliases use.
# just's completion comes from clap's dynamic completer, which puts every
# candidate — every global flag as well as every recipe — into a single
# `_describe -V values` call. One tag, so tag-order and group-order have nothing
# to separate, and -V preserves clap's own order, which is flags first. With ~40
# flags ahead of them the recipes are off the bottom of the screen.
#
# So drop them at the completion layer instead. ignored-patterns matches the
# candidate *value*, which is what makes it the right tool here: `--*` takes the
# flags, `*=` the variable assignments just also offers (BENCH_OPTS=), and `.`
# the bare-dot path.
#
# An fzf --query was the first attempt and is the wrong layer, because fzf
# matches the rendered line — `value -- description`. `!--` hid everything,
# since every line contains that separator. `!^--` fixed the flags but `!=$`
# could not reach the assignments, as fzf-tab pads the display so nothing ends
# where you think it does. Unanchored `!=` did work, and would have silently
# hidden any recipe whose *doc comment* contains an equals sign — three of them
# across cenprof-ai and sdmxlib-rest, including sdmxlib-rest's `pyrefly`
# ("preset = \"all\""). Matching values sidesteps all of it.
#
# just also offers every file and directory in the cwd, since a path is a valid
# argument. Those cannot be matched by shape — `checkfmt` and `default` are
# recipes with no doc comment, so "bare name" describes both — so the list is
# computed instead: ignore anything in the cwd that `just --summary` does not
# name as a recipe. -e makes zstyle evaluate this per completion, which is what
# lets it follow the directory.
#
# Subtracting rather than blanket-ignoring matters: sdmxlib has both a `docs`
# recipe and a docs/ directory, and the recipe has to survive. Note also that
# `*/` would be useless here — the clap completer strips the trailing slash and
# passes the suffix separately, so zsh sees `campaign`, not `campaign/`. That is
# why directories leaked through the first version of this.
#
# ${(@)a:#pat} is the form that actually filters element-wise; both ${a:|b} and
# ${a:#pat} without (@) silently returned the array unchanged on zsh 5.9.
zstyle -e ':completion:*:*:just:*' ignored-patterns '
  local -a _r _f
  _r=(${(z)"$(just --summary 2>/dev/null)"})
  if (( $#_r )); then
    _f=(*(N))
    reply=( "--*" "*=" "." ${(@)_f:#(${(j:|:)~_r})} )
  else
    reply=()
  fi'
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --icons --color=always $realpath'
zstyle ':fzf-tab:complete:__zoxide_z:*' fzf-preview 'eza -1 --icons --color=always $realpath'

# Options
# No COMPLETE_ALIASES: it stops an alias being expanded before completion, so
# `ll --<TAB>` offered nothing where eza's own flags were wanted. No
# APPEND_HISTORY either — SHARE_HISTORY implies it.
setopt SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_SAVE_NO_DUPS HIST_IGNORE_SPACE

# History
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000

# Plugins
# Sourced unguarded on purpose. The guarded form failed *silently*: a missing
# plugin meant no autosuggestions and no explanation for it. The tool evals
# below — fzf, starship, zoxide, direnv — already fail loudly, so this matches
# them. ghcup keeps its guard further down, because that one really is optional.
source "$BREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"

# Prompt
# Guarded so it runs once per shell *process*, not once per source. Starship's
# init preserves any existing zle-keymap-select widget and wraps it, to redraw
# the prompt when the vi mode changes. Sourced a third time that wrapping eats
# itself: the second run leaves the widget as starship_zle-keymap-select-wrapped,
# so the third preserves *that* name and then redefines the function under it to
# call the preserved name — i.e. itself. The result is
#
#     starship_zle-keymap-select-wrapped:1: maximum nested function level
#     reached; increase FUNCNEST?
#
# on every Esc, once `source ~/.zshrc` has been run three times in one shell.
# The flag is deliberately not exported: a nested shell is a new process and must
# initialise starship itself, which an exported guard (STARSHIP_SHELL is the
# obvious candidate) would wrongly suppress.
if [[ -z "${_STARSHIP_INIT_DONE:-}" ]]; then
    eval "$(starship init zsh)"
    typeset -g _STARSHIP_INIT_DONE=1
fi

export EDITOR=nvim
export VISUAL=nvim

# zk (Zettelkasten notebook) — lets zk commands run from anywhere
export ZK_NOTEBOOK_DIR="$HOME/notes"

# Aliases
alias ls='eza --group-directories-first --icons=auto'
alias ll='eza -lh --git'
alias la='eza -lha'

# Zoxide
eval "$(zoxide init zsh)"

# Vi mode
bindkey -v
export KEYTIMEOUT=10
bindkey '^P' history-search-backward
bindkey '^N' history-search-forward
bindkey '^Y' autosuggest-accept

# Atuin — SQLite-backed history, replacing fzf's C-r. Records cwd, exit code and
# duration per command, which is what makes `--cwd .` and `--exit 0` possible;
# a flat HISTFILE has nowhere to put them.
#
# Placed here because it has to come after all three of:
#   * fzf, which binds C-r above — atuin must run later to take it.
#   * zsh-autosuggestions, which must already have set ZSH_AUTOSUGGEST_STRATEGY.
#     atuin *prepends* itself, so sourced first it becomes ("atuin") alone and
#     silently drops the history fallback instead of ("atuin" "history").
#   * bindkey -v, so the keymaps it binds into are the ones in use.
#
# --disable-ai drops `bindkey '?' self-atuin-ai-question-mark`, which atuin emits
# with no -M and so lands in whatever keymap is current — viins here. It does
# fall through to self-insert, but rebinding a bare `?` in insert mode is not a
# risk worth carrying for a feature this config does not use.
eval "$(atuin init zsh --disable-ai)"

# Give vi normal mode back its two motions. atuin binds vicmd `k` to its search
# UI — unconditionally, unless the buffer is multi-line — and vicmd `/` likewise,
# which leaves normal mode unable to move up a line or start a search. That is
# broken vi rather than a different history tool, and C-r and Up already reach
# atuin from insert mode, which is where the feature actually lives.
# Delete these two lines to run atuin's stock bindings.
bindkey -M vicmd 'k' up-line-or-history
bindkey -M vicmd '/' vi-history-search-backward

# use direnv for automatic .env loading
eval "$(direnv hook zsh)"

# ghcup (Haskell toolchain: ghc, cabal, hls)
[ -f "$HOME/.ghcup/env" ] && . "$HOME/.ghcup/env"

# zsh-syntax-highlighting (must be last)
source "$BREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

# Setup personal path
path=($HOME/.local/bin $HOME/bin $path)
typeset -U path   # dedupe, keeps first occurrence, repeated sourcing .zshrc won't stack
