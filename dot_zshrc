# Only run this file for interactive shells
[[ -o interactive ]] || return

# Don't let Ctrl-S freeze the terminal
stty -ixon

# Logic for uv and fzf
export FZF_DEFAULT_COMMAND='fd --type f'

# Completion FIRST
autoload -Uz compinit
if [[ $(find "$HOME/.zcompdump" -mmin +1440 2>/dev/null) ]]; then
  compinit -u -d "$HOME/.zcompdump"
else
  compinit -u -C -d "$HOME/.zcompdump"
fi

setopt COMPLETE_ALIASES

# History
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt APPEND_HISTORY INC_APPEND_HISTORY SHARE_HISTORY
setopt HIST_IGNORE_ALL_DUPS HIST_SAVE_NO_DUPS

# make sure you intall this with brew install zsh-autosuggestions
if [[ -r $(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
  source $(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh
fi

# Prompt (can be before or after; after is fine)
eval "$(starship init zsh)"

# Aliases
alias ls='eza --group-directories-first --icons'
alias ll='eza -lh --git'
alias la='eza -lha'

# Use zoxide for cd freq mapping
# z  = smart jump (what you use interactively)
# zi = interactive picker with fzf
# cd = still real cd (predictable, safe for scripts)
eval "$(zoxide init zsh)"

# Setup vim mode, cus its rad
bindkey -v
export KEYTIMEOUT=1

function zle-line-init zle-keymap-select {
    zle reset-prompt
    zle -R
}
zle -N zle-line-init
zle -N zle-keymap-select

# Use fzf to use the command history with C-R for history and C-T for file picker, and Alt-C for cd
source <(fzf --zsh)

# Make sure we don't mess up tmux titles
DISABLE_AUTO_TITLE=true
