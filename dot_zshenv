# Read by every zsh, interactive or not, and before .zshrc.
#
# .zshrc sets the same path further down, which covers interactive shells; this
# is what puts ~/.local/bin in front for non-interactive ones — scripts with a
# `#!/usr/bin/env zsh` line, `zsh -c`, and anything a tool spawns. uv installs
# there (ruff, basedpyright, debugpy, djlint via bootstrap.sh).
#
# The three directories are the same three .zshrc lists, in the same order. ~/bin
# used to be missing from this copy, so the scripts in it — dev, new-session,
# claude-window — resolved only in an interactive shell. Everything still worked,
# because tmux is started from one and hands its environment to the popup and to
# run-shell, but the moment that chain does not begin interactively the picker
# cannot find new-session and prefix + C cannot find claude-window.
#
# $HOME rather than a literal path: uv's installer wrote this file with
# /Users/gabrielgellner hardcoded, which would have expanded to nothing useful
# on the Linux machine had it ever been synced.
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$HOME/bin:$PATH"
