<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs `mbsync proton` every two minutes, so the maildir NeoMutt reads (see
  ~/.config/isyncrc) keeps up with Proton whether a client is open or not.
  NeoMutt itself never runs mbsync; it re-reads the maildir on its own check.
  To sync now, kickstart this job rather than running mbsync by hand: launchd
  never runs two instances of one job, and two mbsyncs at once collide
  ("Error: channel ... is locked").

  After each sync it runs `notmuch new`, so the search index (see
  ~/.config/notmuch/default/config) follows the maildir — including moves and
  deletes made in NeoMutt. It runs even when mbsync fails, since local changes
  still need indexing, but the job exits with mbsync's status, so a sync
  failure (Bridge not running) is what `launchctl print` reports.

  Loaded by run_onchange_after_load-mbsync-agent.sh whenever this file changes.
  -q keeps the log to errors, which is mostly "connection refused" while Bridge
  is not running.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.mbsync-proton</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>{{ lookPath "mbsync" }} -q proton; rc=$?; {{ lookPath "notmuch" }} new --quiet; exit $rc</string>
	</array>
	<key>StartInterval</key>
	<integer>120</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardOutPath</key>
	<string>{{ .chezmoi.homeDir }}/Library/Logs/mbsync-proton.log</string>
	<key>StandardErrorPath</key>
	<string>{{ .chezmoi.homeDir }}/Library/Logs/mbsync-proton.log</string>
</dict>
</plist>
