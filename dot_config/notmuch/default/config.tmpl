# notmuch — one search index over all the mail under ~/.local/share/mail:
#   proton/         the maildir mbsync keeps from Proton (~/.config/isyncrc)
#   gmail-archive/  the Gmail Takeout history, read-only, local only, tag:gmail
# One index rather than two because NeoMutt opens a single notmuch database, so
# a search there covers both. mbsync syncs only proton/ (its Path), never the
# archive. Folder names therefore carry the prefix: folder:proton/INBOX.
# Searches are read-only; the index lives outside the mail, so mbsync never
# sees it. Kept current by the launchd agent, which runs `notmuch new` after
# each sync (local.mbsync-proton).

[database]
path={{ .chezmoi.homeDir }}/.local/share/notmuch/mail
mail_root={{ .chezmoi.homeDir }}/.local/share/mail

[user]
name=Gabriel Gellner
primary_email={{ .proton_email }}

[new]
# No tags of its own: unread, flagged and replied come from the maildir flags
# (see [maildir]), and folders are searched as folder:, not as tags.
tags=
# mbsync's AltMap UID databases, one per folder; not mail.
ignore=.isyncuidmap.db

[search]
# Deliberately empty: setup puts deleted;spam here, but Trash and Spam are
# folders on this maildir, and the deleted tag must never be used — see below.
exclude_tags=

[maildir]
# Tags and maildir flags mirror each other, so reading or starring something
# through notmuch reaches Proton via mbsync. The hazard is the deleted tag: it
# maps to the T (trashed) flag, and with mbsync's Expunge Both that is a
# permanent delete on Proton. Never tag anything deleted; delete in NeoMutt.
synchronize_flags=true

[query]
# NeoMutt's two sidebar searches, by name (notmuch://?query=query:recent). In
# the URL they were indented in the sidebar one level per / in the query, since
# sidebar_folder_indent counts slashes in the whole path; a name has none.
# Proton only: the archive keeps receiving a copy of whatever Gmail forwards.
recent=date:14d.. and path:proton/** and not folder:proton/Trash and not folder:proton/Spam
starred=tag:flagged and path:proton/** and not folder:proton/Trash
