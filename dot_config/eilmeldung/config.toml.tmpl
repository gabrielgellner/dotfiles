# eilmeldung — TUI RSS reader.
#
# Only settings that DIFFER from the shipped defaults belong here; upstream's
# examples/default-config.toml is reference, not a starting point. Everything
# else — keybindings, layout, icons, labels — is left at its default.

{{ if eq .chezmoi.os "darwin" -}}
# Enclosures (video/audio/image attachments). Upstream defaults to `xdg-open`,
# which does not exist here.
enclosure_command = "open {url}"

{{ end -}}
# Popups (help, command prompt, confirmations) are drawn with a drop shadow by
# default — a band of `░` down the right edge and along the bottom. Off.
shadows = false

# Log in without the first-run wizard. The "Local RSS" provider keeps
# everything in the local news-flash database and has no account, so there is
# nothing to authenticate — but without this section eilmeldung still drops
# into the interactive setup on a fresh machine.
#
# Feeds themselves live in that database, which is machine-local state and not
# tracked. `feeds.opml` next to this file is the tracked copy; re-seed a new
# machine with:
#
#     eilmeldung --import-opml ~/.config/eilmeldung/feeds.opml
#
# and write changes made in the TUI back with:
#
#     eilmeldung --export-opml ~/.config/eilmeldung/feeds.opml
#     chezmoi re-add ~/.config/eilmeldung/feeds.opml
[login_setup]
login_type = "no_login"
provider = "local_rss"

# Catppuccin Frappé, the same palette as dot_config/kitty/catppuccin-frappe.conf
# and dot_tmux.conf. Only [theme.color_palette] is set: every entry in the
# default [theme.style_set] already refers to these names by name, so styling
# components one by one would just restate defaults.
#
# `background` is deliberately absent. eilmeldung emits SGR 49 — the terminal's
# default background — for every cell, including under `reversed`; capturing
# the pane with `tmux capture-pane -e` while driving 1.7.3 found no `48;2;…`
# fill anywhere in the main view or a sync tooltip. The background is kitty's,
# which is this same frappé base. The six entries below were confirmed the same
# way: mauve on feeds and the focused border, blue on categories, teal on Tags,
# yellow on the saved queries, overlay0 on unfocused borders, text on articles.
[theme.color_palette]
foreground        = "#c6d0f5" # text
muted             = "#737994" # overlay0 — borders, inactive items
highlight         = "#e5c890" # yellow   — search matches, yanked
flagged           = "#e78284" # red
accent_primary    = "#ca9ee6" # mauve    — feeds, focused border, status bar
accent_secondary  = "#8caaee" # blue     — categories
accent_tertiary   = "#81c8be" # teal     — tags
accent_quaternary = "#e5c890" # yellow   — saved queries
info              = "#8caaee" # blue
warning           = "#e5c890" # yellow
error             = "#e78284" # red
