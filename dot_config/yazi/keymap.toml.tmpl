# Keys added to yazi's own, not in place of them.
#
# `prepend_keymap` merges; a bare `keys = [...]` in the same section replaces
# the whole default set, which is how a keymap file usually loses navigation
# before it is noticed.
#
# `c` is yazi's copy-something prefix — c, C, d, D, f, n are all "copy the
# path / URL / filename", read off the which-key popup on 26.9.1 — so `a` is
# free under it and archive is the obvious thing for the letter to mean.
# compress.yazi asks for the output name and picks the format from the
# extension you type: `.zip`, `.7z`, `.tar.zst`, and so on.
[[mgr.prepend_keymap]]
on = ["c", "a"]
run = "plugin compress"
desc = "Archive the selection"

# Vim counts, from relative-motions.yazi; init.lua holds its options and the
# reasoning. Only 1-9 are bound: the plugin grabs the keyboard after the first
# digit and reads the rest itself, so `0` is reachable as a later digit (`10j`)
# without being a binding of its own — and a bare `0` stays free.
#
# Nothing of yazi's own is displaced. Measured on 26.9.1 against a stock config
# (`YAZI_CONFIG_HOME` pointed at an empty directory): all ten digits leave the
# pane unchanged, and none is a silent prefix — after pressing 0-9 in sequence,
# a single `j` still moved exactly one row.
[[mgr.prepend_keymap]]
on = ["1"]
run = "plugin relative-motions 1"
desc = "Move in relative steps"

[[mgr.prepend_keymap]]
on = ["2"]
run = "plugin relative-motions 2"
desc = "Move in relative steps"

[[mgr.prepend_keymap]]
on = ["3"]
run = "plugin relative-motions 3"
desc = "Move in relative steps"

[[mgr.prepend_keymap]]
on = ["4"]
run = "plugin relative-motions 4"
desc = "Move in relative steps"

[[mgr.prepend_keymap]]
on = ["5"]
run = "plugin relative-motions 5"
desc = "Move in relative steps"

[[mgr.prepend_keymap]]
on = ["6"]
run = "plugin relative-motions 6"
desc = "Move in relative steps"

[[mgr.prepend_keymap]]
on = ["7"]
run = "plugin relative-motions 7"
desc = "Move in relative steps"

[[mgr.prepend_keymap]]
on = ["8"]
run = "plugin relative-motions 8"
desc = "Move in relative steps"

[[mgr.prepend_keymap]]
on = ["9"]
run = "plugin relative-motions 9"
desc = "Move in relative steps"

# ── whoosh bookmarks, on vim's marks grammar ──────────────────────────────────
#
# `m` sets and `'` jumps, which is vim's `m{key}` / `'{key}` keystroke for
# keystroke — whoosh takes the keyboard after the first press and reads the
# bookmark key itself, exactly as relative-motions does with digits.
#
# `m` is `save_cwd`, not `save`: whoosh's plain `save` bookmarks the *hovered*
# directory and warns "Selected item is not a directory" on anything else, which
# is a poor fit for a key that should mean "mark where I am" — measured by
# hovering a file, where `m` no-ops and the next keystroke falls through to
# yazi's own binding. The hovered-directory form is still there, on `bm`.
#
# `m` was yazi's linemode prefix (ms/mp/mb/mm/mo/mn) and is moved to `i` below.
# That is the one default this file displaces, and it is deliberate: a prefix
# that only changes what each row *shows* is worth less than the mark key to
# anyone coming from vim. `'` and `b` were both unbound — checked against the
# help palette on 26.9.1, which is also where the displacement was found.
[[mgr.prepend_keymap]]
on = ["m"]
run = "plugin whoosh save_cwd"
desc = "Set a bookmark here"

[[mgr.prepend_keymap]]
on = ["'"]
run = "plugin whoosh jump_by_key"
desc = "Jump to a bookmark"

# The management half lives under `b`, away from the hot path. `bb` is the
# ordinary case on a doubled key, and `bd`/`bD` is scope — delete one, delete
# all — which is the case rule this repo's keymaps.md insists on.
#
# Bookmark deletion deliberately does *not* hang off `d`. `d` is a complete
# action (trash), so making it a prefix would put a 'what happens when the clock
# wins' race on a key whose timeout destroys files.
[[mgr.prepend_keymap]]
on = ["b", "b"]
run = "plugin whoosh jump_by_fzf"
desc = "Jump to a bookmark (fzf)"

[[mgr.prepend_keymap]]
on = ["b", "m"]
run = "plugin whoosh save"
desc = "Set a bookmark on the hovered directory"

[[mgr.prepend_keymap]]
on = ["b", "t"]
run = "plugin whoosh save_cwd_temp"
desc = "Set a temporary bookmark here"

[[mgr.prepend_keymap]]
on = ["b", "r"]
run = "plugin whoosh rename_by_key"
desc = "Rename a bookmark"

[[mgr.prepend_keymap]]
on = ["b", "d"]
run = "plugin whoosh delete_by_key"
desc = "Delete a bookmark"

[[mgr.prepend_keymap]]
on = ["b", "D"]
run = "plugin whoosh delete_all"
desc = "Delete all bookmarks"

# ── linemode, displaced from `m` by the mark key above ────────────────────────
#
# `i` for the information each row carries. Every one of these is yazi's own
# binding with the prefix changed; the actions are untouched.
[[mgr.prepend_keymap]]
on = ["i", "s"]
run = "linemode size"
desc = "Linemode: size"

[[mgr.prepend_keymap]]
on = ["i", "p"]
run = "linemode permissions"
desc = "Linemode: permissions"

[[mgr.prepend_keymap]]
on = ["i", "b"]
run = "linemode btime"
desc = "Linemode: btime"

[[mgr.prepend_keymap]]
on = ["i", "m"]
run = "linemode mtime"
desc = "Linemode: mtime"

[[mgr.prepend_keymap]]
on = ["i", "o"]
run = "linemode owner"
desc = "Linemode: owner"

[[mgr.prepend_keymap]]
on = ["i", "n"]
run = "linemode none"
desc = "Linemode: none"

# ── audit: case pairs that were never scope ───────────────────────────────────
#
# keymaps.md: "a capital is the wider version of the lowercase key. Never a
# different action, never an on/off partner." Three of yazi's presets break it,
# and `noop` is what takes a preset away — a virtual action added for exactly
# this (yazi CHANGELOG, #1882), and necessary because `prepend_keymap` can only
# add. Measured: with `Y` on noop a yank survives the keypress and still pastes,
# where the preset would have cancelled it.
#
# Note both halves of the test matter. An *unknown* command is also silently
# ignored — a bogus string in `run` produces no error at startup or on press —
# so "the key stopped doing things" alone would not have shown that `noop` is
# real. The changelog is what settles it.

# `y`/`Y` was copy/cancel and `x`/`X` cut/cancel: the on/off partner the rule
# names, twice, with two keys bound to the one action. Cancelling a yank is
# undoing it, so it goes to `u` — free, and undo everywhere else.
[[mgr.prepend_keymap]]
on = ["u"]
run = "unyank"
desc = "Cancel the yank status"

[[mgr.prepend_keymap]]
on = ["Y"]
run = "noop"
desc = "Disabled — cancel yank is `u`"

[[mgr.prepend_keymap]]
on = ["X"]
run = "noop"
desc = "Disabled — cancel yank is `u`"

# `j`/`J` and `k`/`K` moved the cursor and scrolled the *preview pane* — not a
# wider scope, a different pane. Preview scrolling is `<C-e>`/`<C-y>` in vim and
# both were unbound here. Same `seek 5` the presets ran, so the behaviour is
# unchanged; only the key moved.
[[mgr.prepend_keymap]]
on = ["<C-e>"]
run = "seek 5"
desc = "Scroll the preview down"

[[mgr.prepend_keymap]]
on = ["<C-y>"]
run = "seek -5"
desc = "Scroll the preview up"

[[mgr.prepend_keymap]]
on = ["J"]
run = "noop"
desc = "Disabled — preview scroll is `<C-e>`"

[[mgr.prepend_keymap]]
on = ["K"]
run = "noop"
desc = "Disabled — preview scroll is `<C-y>`"

# `d` (trash) and `D` (permanent) are deliberately left alone. It is the one
# case pair here that survives the rule — "permanently" reads as the wider
# version — and the ordering is right the way round: the reflexive, unshifted
# key is the recoverable one. Swapping them to match which key gets used would
# put the irreversible action on the cheaper keystroke, which is the wrong trade
# whatever the muscle memory says.
#
# `d` was never broken. It trashes, and the file leaves the directory cleanly —
# measured under $HOME and under /private/tmp, both on the one APFS volume, with
# no error either time, and the confirm dialog takes `y` and `<Enter>` alike.
# What is missing is the evidence: see `gt` below.
{{ if eq .chezmoi.os "darwin" }}
# ── macOS: make `gt` work rather than advertise a key that cannot ─────────────
#
# yazi's `gt` goes to `trash:///@//` and fails there with "Operation not
# permitted (os error 1)". That is macOS TCC, not yazi: a terminal without Full
# Disk Access cannot read ~/.Trash at all — plain `ls ~/.Trash` gives the same
# error, which is also why `d` looks like it did nothing.
#
# keymaps.md says to hide a key that can only error. Handing it to Finder is
# better than hiding it: Finder holds the entitlement the terminal does not, so
# `open ~/.Trash` shows the trash with no privilege granted to the terminal —
# measured, the window comes up titled "Trash" while this shell still cannot
# list the directory.
#
# Linux keeps yazi's own `gt`, where the trash is an ordinary readable
# directory and the preset works. Which is why this file is a template.
[[mgr.prepend_keymap]]
on = ["g", "t"]
run = 'shell -- open ~/.Trash'
desc = "Open the Trash in Finder"
{{ end }}
