# Layered over aerc's own `catppuccin` styleset (styleset-name in aerc.conf
# lists both), which is already Frappé but colours little beyond the selected
# row: every column and folder came out in one text colour. This adds the rest
# from the same palette, so the shipped file stays unvendored.

# catppuccin's `default.fg` gives every row a foreground, and a row with one
# ignores the user styles below — the columns all came out #c6d0f5 until this
# line. `default` is the terminal's own foreground, which kitty already paints
# Frappé text, so nothing changes but the columns get their colours back.
msglist_default.fg=default

# Folders with unread mail stand out from the rest.
dirlist_unread.fg=#8caaee
dirlist_unread.bold=true

# A marked message (for a bulk action) has to be unmistakable.
msglist_marked.bg=#51576d
msglist_marked.fg=#f4b8e4
msglist_deleted.fg=#e78284

# The From:/Date:/Subject: labels above an open message. [viewer]'s header,
# below, is a different thing: the headers colorize prints inside the body.
header.fg=#8caaee
header.bold=true

# Named styles for the column templates in aerc.conf (`.Style ... "from"`).
# A user style's colour only shows where the row's own style sets none, which
# is why unread rows are bold rather than recoloured.
[user]
from.fg=#8caaee
date.fg=#838ba7
thread.fg=#626880
flags.fg=#ca9ee6
count.fg=#ef9f76

[viewer]
header.fg=#8caaee
