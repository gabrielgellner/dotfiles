# Proton Mail through Proton Mail Bridge, which serves IMAP on 1143 and SMTP on
# 1025 on localhost, and does the encryption to Proton itself.
#
# Reading is from the local maildir mbsync keeps (~/.config/isyncrc), not from
# Bridge directly: over Bridge's IMAP aerc cannot sort. Sending still goes to
# Bridge, which also files the copy in Sent; mbsync brings it back down.
#
# `+insecure` means no STARTTLS on that loopback hop. Bridge's STARTTLS uses a
# self-signed certificate, and plain text over loopback avoids exporting and
# pinning it; the verifying `imap://` was not tried.
#
# The password is Bridge's own (it shows it per account), not the Proton
# login, and comes from the login keychain — nothing secret is in this file.
# private_ because aerc refuses an accounts.conf anyone else can read.

[Proton]
source            = maildir://{{ .chezmoi.homeDir }}/.local/share/mail/proton
# mbsync itself runs from a launchd agent every 2m (local.mbsync-proton), so
# mail keeps syncing with aerc closed. This only kickstarts that job — at
# startup, on the interval, and on `:check-mail` — because launchd runs one
# instance at a time and two mbsyncs at once collide on its locks.
check-mail-cmd    = launchctl kickstart gui/{{ output "id" "-u" | trim }}/local.mbsync-proton
check-mail        = 1m
outgoing          = smtp+insecure://{{ .proton_email | urlquery }}@127.0.0.1:1025
outgoing-cred-cmd = security find-generic-password -s proton-bridge -w
from              = Gabriel Gellner <{{ .proton_email }}>
folders-sort      = INBOX,Drafts,Sent,Archive,Spam,Trash
# No copy-to, deliberately: Bridge files every message sent through it in Sent
# on its own. A mail sent with himalaya's --no-save still landed there once
# (measured 2026-10-24), so copy-to = Sent would make two.
