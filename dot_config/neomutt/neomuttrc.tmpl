# NeoMutt — the mail client. It reads the local maildir that mbsync mirrors
# from Proton Mail Bridge (~/.config/isyncrc) and sends through Bridge's SMTP.
# Chosen over aerc after running both side by side (2026-10-24); see
# CLAUDE.md, Mail.

# ── Mailboxes ────────────────────────────────────────────────────────────────
set mbox_type = Maildir
set folder = "~/.local/share/mail/proton"
set spool_file = "+INBOX"
set postponed = "+Drafts"
set header_cache = "~/.cache/neomutt-headers"

# Proton semantics, measured with mbsync (see CLAUDE.md, Mail): a plain delete
# in Inbox or Archive leaves the message in no folder at all. $trash turns a
# delete into a move to Trash, and it is set everywhere, label folders
# included, so d means one thing wherever you are. Labels have their own keys,
# + and - (below), rather than d meaning "take the label off" inside a label
# folder, which it used to.
set trash = "+Trash"

# Bridge files every sent message in Sent itself (measured), so no local copy.
set copy = no
set record = ""

named-mailboxes "󰚇 Inbox" "+INBOX" "󰷉 Drafts" "+Drafts" "󰒊 Sent" "+Sent" \
                "󰀼 Archive" "+Archive" "󰀩 Spam" "+Spam" "󰩺 Trash" "+Trash"
# Labels are read off the disk at startup, so a new one appears on the next
# launch. Quoted and escaped because the names have spaces, an ampersand and,
# in one Gmail-import leftover, a literal backslash.
mailboxes `cd ~/.local/share/mail/proton && find Labels -type d -name cur | sed 's|/cur$||' | sort -f | sed 's/[\\"]/\\&/g; s/.*/"+&"/' | tr '\n' ' '`

# ── Search (notmuch) ──────────────────────────────────────────────────────────
# notmuch indexes all the mail under ~/.local/share/mail — the Proton maildir
# (proton/) and the Gmail archive (gmail-archive/, tag:gmail) — so a search
# covers every folder of both, and a thread includes your replies in Sent. The
# URL names the *database*, which lives apart from the mail: pointing it at the
# maildir opened nothing (measured). Results are ordinary messages — d in a
# search moved the file to Trash, the same as in a folder.
set nm_default_url = "notmuch://{{ .chezmoi.homeDir }}/.local/share/notmuch/mail"
set nm_query_type = threads
# Both saved searches are Proton only: the archive keeps receiving a copy of
# whatever Gmail forwards, which would otherwise show up here twice.
virtual-mailboxes "󰃰 Last 2 weeks" "notmuch://?query=date:14d.. and path:proton/** and not folder:proton/Trash and not folder:proton/Spam" \
                  "󰈻 Starred" "notmuch://?query=tag:flagged and path:proton/** and not folder:proton/Trash"
# Search everything: \ then a notmuch query (from:amy, subject:passport, …);
# tag:gmail narrows to the Gmail archive, e.g. tag:gmail tag:"Product Serial".
bind index,pager \\ vfolder-from-query

# ── Sending ──────────────────────────────────────────────────────────────────
set real_name = "Gabriel Gellner"
set from = "{{ .proton_email }}"
set smtp_url = "smtp://{{ .proton_email | urlquery }}@127.0.0.1:1025/"
set smtp_pass = `security find-generic-password -s proton-bridge -w`
# Loopback to Bridge, whose STARTTLS cert is self-signed; see ~/.config/isyncrc.
# ssl_force_tls defaults to yes and would refuse it.
set ssl_starttls = no
set ssl_force_tls = no

# ── Behaviour ────────────────────────────────────────────────────────────────
# Newest thread activity first, and oldest-first inside a thread.
set use_threads = threads
set sort = reverse-last-date
set sort_aux = date
# Poll every 30s, idle or not — timeout defaults to 600, so an idle NeoMutt
# would otherwise notice mail every ten minutes. (No inotify in this build.)
set mail_check = 30
set timeout = 30
set mail_check_stats = yes
# Deletes and moves happen on sync ($, leaving the folder, quitting); do them
# without asking, and without the save-to-folder confirmation.
# q in the index quits NeoMutt, the same key that only goes back from the
# pager. ask-no makes it a question whose default is "stay": q then Enter (or
# anything but y) keeps you in. It covers x, exit-without-saving, as well.
set quit = ask-no
set delete = yes
# sleep_time pauses after messages like "Mailbox synced" — a full second by
# default, on every $, archive or delete. Timed on a full copy of the maildir:
# a sync took 1.09s with it and 0.04s without.
set sleep_time = 0
set confirm_append = no
set mark_old = no
# Threads open collapsed, one row each; the row shows how many it hides, and
# a collapsed thread with anything unread in it is drawn bold blue (below).
folder-hook . 'push <collapse-all>'
set edit_headers = yes

set mailcap_path = "~/.config/neomutt/mailcap"
auto_view text/html
alternative_order text/plain text/enriched text/html

# ── Layout ───────────────────────────────────────────────────────────────────
set sidebar_visible = yes
set sidebar_width = 26
set sidebar_short_path = yes
set sidebar_folder_indent = yes
set sidebar_indent_string = "  "
# Only / separates folders. The default "/." also splits on dots, and turned
# the label "gmail.com 04-11-2024 08:21" into "com 04-11-2024 08:21".
set sidebar_delim_chars = "/"
set sidebar_format = "%D%* %?N?%N?"
# %C is each row's position in the list, so a message can be reached by typing
# the number you can see. (There is no relative numbering in NeoMutt.)
set index_format = "%4C %Z  %-22.22F  %?M?(%M) ?%s%*  %{%b %d}"
# Nerd Font glyphs: tagged, flagged, deleted, deleted-attachment,
# replied, old, new, old-thread, new-thread, then two fillers.
set flag_chars = "󰸞󰈻󰆴󰆴󰑚󰇰󰇮󰇰󰇮- "
# %Z also marks who a message was addressed to (+ for "to you alone"), which on
# a personal mailbox is nearly every row. Empty drops that column.
set to_chars = ""

# ── Keys: vim's where mutt's differ ─────────────────────────────────────────
bind index,pager g noop
# Making g a prefix (for gg) took mutt's own g, group-reply, with it; gr
# brings reply-all back under the same letter.
bind index,pager gr group-reply
bind index gg first-entry
bind index G last-entry
bind pager gg top
bind pager G bottom
bind index,pager \Cd half-down
bind index,pager \Cu half-up
bind pager j next-line
bind pager k previous-line
macro index J "<sidebar-next><sidebar-open>" "next folder"
macro index K "<sidebar-prev><sidebar-open>" "previous folder"
macro index,pager a "<save-message>+Archive<enter>" "archive"
# Labels: + adds one (Tab completes after the prefix), - removes one by
# handing the message to ~/bin/mail-unlabel, which finds its copies under
# Labels/ and asks which to take off. Both work from any folder.
macro index,pager + "<copy-message>+Labels/" "add a label"
macro index,pager - "<pipe-message>~/bin/mail-unlabel<enter>" "remove a label"
# In the attachment list (v): o opens the attachment in its macOS app, whatever
# it is (Enter already shows images inline and opens PDFs; see mailcap).
macro attach o "<pipe-entry>~/bin/mail-open<enter>" "open in its app"
# No "Press any key" after external commands: the tools that need a pause take
# their own (mail-image, mail-unlabel), so with it on an image took two keys to
# leave. The cost: output from ! and | vanishes at once — add `; read` to see it.
set wait_key = no

# ── Colours: Catppuccin Frappé ───────────────────────────────────────────────
# Terminal colour numbers, not hex. NeoMutt takes "#rrggbb" only when TERM
# advertises direct colour (xterm-direct), which tmux's does not: every hex
# line failed with "color not supported by term". The way out: ANSI 0-15
# already *are* Frappé, because kitty paints them from
# catppuccin-frappe.conf — color4 is exactly blue #8caaee, color8 surface2,
# color0 surface1, color15 subtext0. Only what has no ANSI slot is approximated
# from the 256 cube: 183 for mauve #ca9ee6 and 103 for
# overlay1 #838ba7.
color normal          default   default
color indicator       default   color0
color status          color15   color0
color tree            color8    default
color index_number    color8    default
color index_author    color4    default '.*'
color index_date      color103  default
color index_flags     color183  default '.*'
color index           bold default default '~N'
color index           bold color4 default '~v~(~U)'
color index_flags     color3    default '~F'
color index           bold color5 default '~T'
color index           color1    default '~D'
color sidebar_divider color8    default
color sidebar_new     bold color4 default
color sidebar_indicator bold default color0
color sidebar_highlight default color0
color hdrdefault      color15   default
color header          bold color4 default "^(From|To|Cc|Subject|Date):"
color quoted          color15   default
color quoted1         color8    default
color signature       color8    default
color attachment      color183  default
color tilde           color8    default
color markers         color8    default
color search          color0    color3
color error           color1    default
# This build has no `url` object; links are coloured as a body pattern.
color body            underline color4 default "(https?|ftp)://[^ >\"]+"
