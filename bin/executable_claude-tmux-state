#!/usr/bin/env bash
# claude-tmux-state - record whether the Claude session in this tmux session is
# working or idle, so `dev` and the tmux status bar can show it.
#
#   claude-tmux-state working   # a prompt was submitted, or a tool ran
#   claude-tmux-state idle      # Claude stopped responding; records `background`
#                               # instead if work is still running to wake it
#   claude-tmux-state waiting   # a notification fired; the kind is recorded
#   claude-tmux-state clear     # the session ended
#
# Which events exist here was measured, not read off the schema. A throwaway
# `claude` in a detached tmux session, with every candidate event wired to a
# logger, produced: SessionStart, UserPromptSubmit, PreToolUse, PostToolUse,
# Notification, Stop, SubagentStop, SessionEnd. StopFailure, PermissionRequest,
# PermissionDenied, Elicitation and PreCompact stayed silent.
#
# `working` has four writers, and three of them are the fix for a bug this
# script had for its first month. It used to be written by UserPromptSubmit
# alone, which made the state a latch that only a *new prompt* could re-arm.
# Measured sequence, from the log above:
#
#   10:38:07  UserPromptSubmit                 -> working
#   10:38:09  PreToolUse Write
#   10:38:15  Notification permission_prompt   -> waiting
#     ... the prompt is answered ...
#   10:38:28  PostToolUse Write
#   10:38:29  Stop                             -> idle
#
# Nothing between :15 and :29 wrote anything, so the bar said "wants you" for
# the whole of the rest of the turn — 34 minutes in the case that prompted
# this, caught live: session sdmxlib showed `waiting permission_prompt` from
# 19:52 the previous evening while its pane read `✳ Combobulating… (34m 20s)`.
# Long autonomous stretches make it worse: that session's transcript held four
# user prompts in fifteen hours, everything else being re-invocation by
# background-task output, which fires no UserPromptSubmit at all.
#
# So PreToolUse and PostToolUse write `working` too. PreToolUse is the reliable
# one — PostToolUse does *not* fire when a tool errors (measured on a `git
# status` that exited 128: PreToolUse, then straight to Stop). PostToolUse is
# wired anyway for the case PreToolUse cannot cover, a permission granted on a
# tool that then runs for ten minutes.
#
# The two of them fire on every tool call, so this script is on a hot path now.
# It is one `tmux display-message` and one small write, a few milliseconds; the
# write is deliberately unconditional rather than skipped when the file already
# says `working`, because the mtime is then a heartbeat — the last tool call —
# and that is what made the bug above findable.
#
# PostToolUse and Stop land about a second apart at the end of a turn, so a
# slow PostToolUse hook could in principle write `working` after Stop wrote
# `idle`. It self-heals: the idle_prompt notification sixty seconds later
# overwrites it, and that reads as idle. Not seen in practice.
#
# SessionEnd fires on a clean exit only, so claude-tmux-status still checks
# liveness for the case where Claude is killed underneath it.
#
# Called from the hooks in ~/.claude/settings.json. Claude inherits TMUX and
# TMUX_PANE from the shell that launched it — including the instance that
# claudecode.nvim starts, which is a child of `nvim --embed` in the same pane —
# so the pane resolves to a session name and that is the key. One Claude per
# project session is the shape `dev` and new-session already impose.
#
# Silent and successful outside tmux: a hook that fails is noise in the
# transcript, and running Claude outside tmux is a perfectly ordinary thing.

set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/claude-tmux"

[[ -n "${TMUX:-}" ]] || exit 0
command -v tmux >/dev/null || exit 0

# The pane is the reliable handle. `display-message` without -t answers for the
# *attached* client, which is whichever session you happen to be looking at —
# not the one this Claude is running in.
pane="${TMUX_PANE:-}"
[[ -n "$pane" ]] || exit 0

session=$(tmux display-message -p -t "$pane" '#{session_name}' 2>/dev/null) || exit 0
[[ -n "$session" ]] || exit 0

# Session names can contain a slash (tmux allows it); a slash in a filename
# would silently write outside STATE_DIR.
safe=${session//\//%2F}

case "${1:-}" in
  working)
    mkdir -p "$STATE_DIR"
    printf '%s\n' "$1" > "$STATE_DIR/$safe"
    ;;
  idle)
    # Stop does not always mean done. A turn that ends with a shell running in
    # the background, a Monitor watching CI, or a /loop wake-up scheduled is
    # parked, not finished: Claude is re-invoked when that work reports back.
    # That used to read as idle, so a session waiting twenty minutes on CI
    # looked the same as one that had finished. You had to open it to find out.
    #
    # The Stop payload says which. It carries background_tasks and
    # session_crons, and an entry in either means the session will wake itself
    # up. Measured on 2.1.308, with a throwaway Claude told to background
    # `sleep 120` and end its turn:
    #
    #   "background_tasks":[{"id":"b5gaklomw","type":"shell","status":"running",
    #   "description":"Sleep for 120 seconds","command":"sleep 120"}],
    #   "session_crons":[]
    #
    # When the sleep finished Claude woke (`working`) and the next Stop carried
    # `"background_tasks":[]`, which lands here as plain `idle`. So nothing has
    # to clear `background`; the next Stop does it.
    #
    # Read with grep, no jq, for the same reason as notification_type below.
    # The test is only "is either array non-empty": the entries' own strings
    # are JSON-escaped, so a `[{` inside a command cannot fake a match. A
    # terminal on stdin means a hand-run with no payload, which is plain idle.
    state=idle
    if [[ ! -t 0 ]] && grep -Eq '"(background_tasks|session_crons)"[[:space:]]*:[[:space:]]*\[[[:space:]]*\{'; then
      state=background
    fi
    mkdir -p "$STATE_DIR"
    printf '%s\n' "$state" > "$STATE_DIR/$safe"
    ;;
  waiting)
    # The payload carries notification_type, and the *kind* now decides a
    # colour rather than being recorded for interest: idle_prompt means Claude
    # finished and you have not come back, permission_prompt means it is
    # blocked on you. claude-tmux-status paints only the second one pink.
    #
    # Both values are measured. "idle_prompt is the only one seen so far" is
    # what this comment used to say, and the state directory disproved it —
    # sdmxlib held `waiting permission_prompt` on disk.
    #
    # Extracted with grep rather than jq, on purpose. jq is a dependency of
    # nothing else here and is not in bootstrap.sh; it happens to sit in
    # /usr/bin on macOS and may be absent on the Linux machine. That was
    # harmless while the kind was decoration, but now an empty kind would
    # misclassify every notification, so the one flat string field this needs
    # is read without it.
    kind=$(grep -o '"notification_type"[[:space:]]*:[[:space:]]*"[^"]*"' \
      | sed 's/.*"\([^"]*\)"$/\1/' | head -1) || kind=""
    # idle_prompt still fires sixty seconds after a Stop that left background
    # work running (measured: `waiting idle_prompt` 30s into a 120s sleep).
    # It means "you have not come back", which says nothing new about a
    # session already parked on that work, so it must not overwrite
    # `background`.
    if [[ "$kind" == idle_prompt ]] &&
      read -r current _ < "$STATE_DIR/$safe" 2>/dev/null &&
      [[ "$current" == background ]]; then
      exit 0
    fi
    mkdir -p "$STATE_DIR"
    printf 'waiting %s\n' "$kind" > "$STATE_DIR/$safe"
    ;;
  clear)
    rm -f "$STATE_DIR/$safe"
    ;;
  *)
    echo "usage: ${0##*/} working|idle|waiting|clear" >&2
    exit 2
    ;;
esac
