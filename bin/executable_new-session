#!/usr/bin/env bash
# new-session - create a tmux (or kitty) session laid out for a project, then go
# to it.
#
# Called by `dev` when it finds no session for the chosen project, and usable
# by hand: new-session <name> <dir>

SESSION=$1
DIR=$2

if [[ -z "$SESSION" || -z "$DIR" ]]; then
  echo "usage: new-session <session-name> <directory>" >&2
  exit 2
fi

# kitty: the session is a kitty session (0.43+), created from a session file
# rather than built up one command at a time. One console fewer than the tmux
# branch — nvim, console — because here Claude is a tab of its own
# (nvim/lua/config/claude_kitty.lua), which then lands third; just.lua opens
# another console tab when the one is busy. `nvim` is typed into the first
# shell rather than run as its command, so quitting nvim leaves a shell there,
# as in tmux.
#
# The file is rewritten on every call, so it always names the directory `dev`
# just resolved, and lives in $XDG_STATE_HOME: it is generated state, not
# config. kitty names the session after the file, so the basename is the
# session name, dots included (FoodWebs.jl.kitty-session is FoodWebs.jl).
# goto_session on a session that is already open switches to it and creates
# nothing, so this is also how `dev` switches.
#
# Each window is tagged two ways: --env DEV_SESSION, which claude-tmux-state
# reads, and --var dev_role, which just.lua and slime match to find a console.
if [[ "$(dev-mux)" == kitty ]]; then
  dir="${XDG_STATE_HOME:-$HOME/.local/state}/dev/kitty-sessions"
  file="$dir/$SESSION.kitty-session"
  mkdir -p "$dir"

  # A match is a regex: escape the name so FoodWebs.jl's dot is a dot.
  re=$(printf '%s' "$SESSION" | sed 's/[][\\.*^$+?(){}|]/\\&/g')
  existed=0
  kitten @ ls --match "session:^$re\$" >/dev/null 2>&1 && existed=1

  {
    echo "# Written by ~/bin/new-session, and rewritten each time it runs."
    for tab in nvim console; do
      echo "new_tab $tab"
      echo "cd $DIR"
      echo "launch --env DEV_SESSION=$SESSION --var dev_role=${tab/nvim/editor}"
    done
    echo "focus_tab 0"
  } >"$file"

  kitten @ action goto_session "$file" || exit 1
  if ((!existed)); then
    kitten @ send-text --match "session:^$re\$ and var:dev_role=editor" $'nvim\r'
  fi
  exit 0
fi

# Every -t below is "=$SESSION". tmux resolves a target by exact match, then
# *prefix*, then fnmatch, so a bare name can land on a longer sibling — pinax
# reaching pinax-ai, say. Here the session has just been created so the exact
# match wins anyway; the = keeps that true if this is ever called somewhere the
# assumption does not hold. The trailing colon on the session-only targets
# stops a dot in the name (FoodWebs.jl) being read as a pane; see `dev`.
if tmux has-session -t "=$SESSION:" 2>/dev/null; then
  # Already built. Do not lay it out again: `tmux new-session` fails with
  # "duplicate session" but the rest of the script used to carry on regardless,
  # renaming the live session's first window, typing nvim into it and appending
  # two more consoles. Re-running this on a session you are working in is the
  # obvious mistake, and going there is what was meant by it.
  :
else
  tmux new-session -d -s "$SESSION" -c "$DIR" || exit 1

  # first window is the editor
  tmux rename-window -t "=$SESSION:1" nvim

  # two consoles, for a build and something else
  tmux new-window -t "=$SESSION:" -n console -c "$DIR"
  tmux new-window -t "=$SESSION:" -n console -c "$DIR"

  tmux send-keys -t "=$SESSION:nvim" "nvim" Enter
  tmux select-window -t "=$SESSION:nvim"
fi

# attach or switch depending on whether we're already in tmux
if [[ -n "$TMUX" ]]; then
  tmux switch-client -t "=$SESSION:"
else
  tmux attach -t "=$SESSION:"
fi
