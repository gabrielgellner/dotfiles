#!/usr/bin/env zsh

SESSION=$1
DIR=$2

# create session without attaching
tmux new-session -d -s "$SESSION" -c "$DIR"

# rename the first window to nvim
tmux rename-window -t "$SESSION:1" nvim

# create console window
tmux new-window -t "$SESSION" -n console -c "$DIR"

# send nvim command to nvim window
tmux send-keys -t "$SESSION:nvim" "nvim" Enter

# select nvim window on attach
tmux select-window -t "$SESSION:nvim"

# attach or switch depending on whether we're already in tmux
if [ -n "$TMUX" ]; then
  tmux switch-client -t "$SESSION"
else
  tmux attach -t "$SESSION"
fi
