#!/usr/bin/env bash
# claude-tmux-status - one-line summary of Claude activity, for tmux status-right.
#
# Reads the files ~/bin/claude-tmux-state writes from Claude's hooks. Prints
# nothing at all when no Claude is running anywhere, so the status bar stays as
# quiet as it was before this existed.
#
# Colours are #rrggbb rather than the ANSI names dev uses: tmux takes hex
# directly and the status bar already carries frappe values inline
# (dot_tmux.conf), so there is no palette to route through here.

set -uo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/claude-tmux"
[[ -d "$STATE_DIR" ]] || exit 0

# Sessions that actually contain a running Claude, one name per line.
#
# This replaced a `tmux has-session` per state file, and it is both cheaper —
# one ps and one tmux call instead of one tmux call per file — and stricter.
# has-session only caught the case where the whole tmux session went away;
# SessionEnd fires on a clean exit, so a Claude killed underneath a session
# that survives left `working` on disk for ever. Asking after the process
# answers both at once: no live Claude means the file is stale, whatever it
# says.
#
# The walk up ppid is not optional. claudecode.nvim starts Claude as a child of
# `nvim --embed`, itself a child of the pane's nvim, so the chain is three deep
# before it reaches a pane pid — measured on a live session: 472 -> 208 (nvim
# --embed) -> 207 (nvim) -> 99947 (the pane).
#
# Matching is on the basename being exactly `claude`, not a substring: this
# script and claude-tmux-state would both match a looser test.
live_sessions() {
  {
    ps -Ao pid=,ppid=,comm=
    echo '---'
    tmux list-panes -a -F '#{pane_pid} #{session_name}' 2>/dev/null
  } | awk '
    /^---$/ { panes = 1; next }
    !panes {
      line = $0
      sub(/^[ \t]*[0-9]+[ \t]+[0-9]+[ \t]+/, "", line)
      sub(/.*\//, "", line)
      ppid[$1] = $2
      if (line == "claude") claude[++n] = $1
      next
    }
    { pane[$1] = substr($0, index($0, " ") + 1) }
    END {
      for (i = 1; i <= n; i++) {
        p = claude[i]
        # 24 is a ceiling, not a depth anyone reaches; it stops a ppid cycle
        # (which cannot happen) from hanging the status bar (which would).
        for (h = 0; h < 24 && p != "" && p != 0 && p != 1; h++) {
          if (p in pane) { print pane[p]; break }
          p = ppid[p]
        }
      }
    }
  ' | sort -u
}

live=$(live_sessions)
# Delimited on both ends so a substring match cannot succeed against a longer
# name. Pure bash rather than a grep per file: this runs every five seconds.
live_set=$'\n'"$live"$'\n'

working=0
idle=0
waiting=0
for f in "$STATE_DIR"/*; do
  [[ -r "$f" ]] || continue
  name=${f##*/}
  name=${name//%2F//}
  [[ "$live_set" == *$'\n'"$name"$'\n'* ]] || continue
  # "waiting <notification_type>" — the kind is the difference between the two
  # things pink used to mean at once.
  read -r state kind < "$f" 2>/dev/null || continue
  case "$state" in
    working) working=$((working + 1)) ;;
    idle) idle=$((idle + 1)) ;;
    waiting)
      # idle_prompt is not a question. It fires sixty seconds after Stop and
      # means "finished, and you have not come back" — which is what green
      # already says, so it goes in the idle bucket. Pink is reserved for the
      # kinds that are genuinely blocked on you, permission_prompt being the
      # one seen. An unknown or missing kind counts as blocked: a false pink
      # costs a glance, a missed one costs the wait it was there to prevent.
      case "$kind" in
        idle_prompt) idle=$((idle + 1)) ;;
        *) waiting=$((waiting + 1)) ;;
      esac
      ;;
  esac
done

# All three are always drawn, including at zero. A number that appears and
# disappears makes the bar jump and gives you nothing to glance at when the
# answer is "nothing is running"; a fixed three slots means each state always
# occupies the same position, so the eye learns where to look rather than
# reading left to right. At zero they drop to overlay0, the same grey the date
# uses for things you are not meant to read unless you look.
#
# Waiting used to be the exception, on the grounds that an empty slot would
# train the eye to skip the position it appears in. The opposite turned out to
# matter more: a slot that moves the two beside it whenever it appears is worse
# than one that is reliably there and usually grey.
#
# The order is by glyph height, not by importance: ⣿ then ⣤ then ⣀ is a
# descending staircase, so the row reads as a shape before it reads as numbers.
# That it also runs active, waiting, idle is a coincidence worth keeping.
if ((working)); then
  out="#[fg=#e5c890]⣿ $working#[default] "
else
  out="#[fg=#737994]⣿ 0#[default] "
fi
# Pink, matching the [q] in `dev`.
if ((waiting)); then
  out+="#[fg=#f4b8e4]⣤ $waiting#[default] "
else
  out+="#[fg=#737994]⣤ 0#[default] "
fi
if ((idle)); then
  out+="#[fg=#a6d189]⣀ $idle#[default] "
else
  out+="#[fg=#737994]⣀ 0#[default] "
fi
printf '%s' "$out"
