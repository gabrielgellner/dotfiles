#!/usr/bin/env bash
# dev - fuzzy-pick an active tmux session or project from ~/dev

# Every tmux -t target below is written "=$name". The leading = forces an exact
# match: without it tmux tries exact, then *prefix*, then fnmatch, so with a
# pinax-ai session running and no pinax session, `has-session -t pinax` answers
# true and switch-client lands in pinax-ai. Real collisions here today are
# pinax against pinax-{ai,harmonization,suite-docs} and sdmxlib against
# sdmxlib-rest. The kill binding matters most: ctrl-x on pinax would otherwise
# kill pinax-ai, silently.
#
# That binding writes the target as \={-1}, and the backslash is load-bearing.
# fzf runs an execute binding through $SHELL — *not* through the shell this
# script is written in, which is why the backslash survived the move to bash;
# tested by launching fzf from bash and having the binding report $0, which came
# back /bin/zsh. fzf substitutes {-1} already single-quoted, so a bare ={-1}
# reaches zsh as ='name', where a leading = is EQUALS expansion (=foo means "the
# path to command foo"). zsh reported "name not found" and tmux never ran, so
# ctrl-x silently stopped killing anything. Double-quoting cannot fix it: fzf
# supplies its own quotes inside, which would end up in the target name. The
# backslash suppresses the expansion and leaves the word as =name.
#
# Written for bash 3.2, the version macOS ships, so /bin/bash runs it. That
# rules out associative arrays and mapfile; see EXTRA_PROJECTS below.
DEV_DIR="$HOME/dev"

# Extra projects outside DEV_DIR, one "name<TAB>path" per line. This is the
# single source of both the names and their paths — bash 3.2 has no
# associative arrays, and two parallel lists would be one more thing to keep
# in step.
EXTRA_PROJECTS="dotfiles	$HOME/.local/share/chezmoi"

extra_names() {
  printf '%s\n' "$EXTRA_PROJECTS" | cut -f1
}

resolve_dir() {
  local name="$1" path
  path=$(printf '%s\n' "$EXTRA_PROJECTS" | awk -F'\t' -v n="$name" '$1 == n { print $2; exit }')
  if [[ -n "$path" ]]; then
    printf '%s\n' "$path"
  else
    printf '%s\n' "$DEV_DIR/$name"
  fi
}

# Live sessions, most-recently-attached first. Alphabetical order made the list
# stable but made swapping between two sessions a reading exercise: the one you
# just came from sat wherever its name fell. This is the alt-tab ordering — the
# session you were in last is the top entry, so the common case is one keypress.
#
# The current session is pushed to the end of the group rather than dropped. It
# sorts newest by definition, so leaving it in place would park the one session
# you cannot switch to in exactly the slot the cursor starts on; but it is still
# worth showing, not least so ctrl-x can reach it.
#
# session_last_attached is empty for a session that has never had a client. Those
# sort as 0, i.e. last among the active ones, which is the right place for them.
#
# Only this group is reordered. The project list below stays alphabetical: it is
# long and browsed by name, and churn there would cost more than it gave.
# Sessions that are not projects and never worth switching *to* from here.
#
# The player (gmuse) lives in its own session so prefix + C-p can reach it from
# anywhere (dot_tmux.conf); it is a player you toggle over the top of your work,
# not a place you go. Listing it here put it among the projects and gave it a
# switch-to entry it has no use for — and, worse, a ctrl-x that would kill the
# music.
#
# The name is `music`, not `gmuse`, because ~/dev/gmuse is a project and the
# sessions here are named after project directories. `gmuse` would have hidden
# the player's own *source* session from this picker and taken its ctrl-x with
# it — the exact opposite of what this list is for.
#
# Hidden here still leaves two deliberate ways to end it, which matters while
# gmuse is being developed and the running player has to get out of a test's
# way: `q` inside the popup quits the player and the session dies with it,
# since gmuse is the session's only command. `tmux kill-session -t music`
# does the same from anywhere. Neither is reachable by a stray ctrl-x here,
# which is the whole point.
UTILITY_SESSIONS="music"

is_utility() {
  local n
  for n in $UTILITY_SESSIONS; do
    [[ "$1" == "$n" ]] && return 0
  done
  return 1
}

active_sessions() {
  local current="" names n
  [[ -n "$TMUX" ]] && current=$(tmux display-message -p '#{session_name}' 2>/dev/null)

  names=$(tmux list-sessions -F "#{session_last_attached}$(printf '\t')#{session_name}" 2>/dev/null |
    sort -t "$(printf '\t')" -k1,1nr | cut -f2)
  [[ -z "$names" ]] && return

  while IFS= read -r n; do
    is_utility "$n" && continue
    [[ -n "$n" && "$n" != "$current" ]] && printf '%s\n' "$n"
  done <<<"$names"

  # Re-add the current session last, but only if it really was in the list.
  if [[ -n "$current" ]] && ! is_utility "$current"; then
    while IFS= read -r n; do
      if [[ "$n" == "$current" ]]; then
        printf '%s\n' "$n"
        break
      fi
    done <<<"$names"
  fi
}

# Is $1 one of the newline-separated names in $2?
is_active() {
  [[ -n "$2" ]] && printf '%s\n' "$2" | grep -qxF -- "$1"
}

# Claude's state in session $1, as a coloured marker, or empty.
#
# Written by ~/bin/claude-tmux-state from the UserPromptSubmit / Stop hooks in
# ~/.claude/settings.json. Absent file means no Claude is running there.
#
# The marker goes *before* the name, never after. fzf is given `{-1}` — the
# last field — by the ctrl-x kill binding, so anything trailing the name would
# be passed to tmux as the session to kill.
#
# Colours are the plain ANSI names rather than 256-cube indices, so kitty
# resolves them to frappe exactly: yellow #e5c890 for working, green #a6d189
# for idle — an index would be whatever the terminal's cube holds there, which
# is not the palette. (This pointed at dot_config/private_cmus/rc, which stated
# the same rule; that file went with cmus.)
claude_marker() {
  local f="${XDG_STATE_HOME:-$HOME/.local/state}/claude-tmux/${1//\//%2F}"
  [[ -r "$f" ]] || return 0
  # The file is "working", "idle", or "waiting <notification_type>".
  local state
  read -r state _ < "$f" 2>/dev/null || return 0
  case "$state" in
    # Bold for the one that is running, so it carries on being findable at a
    # glance without a second glyph beside the ● that already means "active".
    working) printf '\033[1;33m[a]\033[0m ' ;;
    idle) printf '\033[32m[i]\033[0m ' ;;
    waiting) printf '\033[35m[q]\033[0m ' ;;
  esac
}

list_items() {
  local active s proj
  active=$(active_sessions)

  if [[ -n "$active" ]]; then
    while IFS= read -r s; do
      printf '● %s%s\n' "$(claude_marker "$s")" "$s"
    done <<<"$active"
  fi

  # A glob rather than `ls -1`: same alphabetical order and same set (both skip
  # dotfiles), but nothing has to parse a filename back out of a listing.
  local path
  for path in "$DEV_DIR"/*; do
    [[ -e "$path" ]] || continue
    proj="${path##*/}"
    is_active "$proj" "$active" || printf '%s\n' "$proj"
  done

  extra_names | while IFS= read -r proj; do
    is_active "$proj" "$active" || printf '%s\n' "$proj"
  done
}

if [[ "${1}" == "--list" ]]; then
  list_items
  exit 0
fi

SELF="$0"

# --nth=-1 and --tiebreak=index are what put active sessions first when you
# type.
#
# Without them the `● [a] ` prefix works against the sessions it marks: fzf
# scores a match that begins later in the line lower, so the marker itself
# demoted them. Typing "dot" ranked the inactive dotstat above the running
# dotfiles, and "pin" put pinax-ai above pinax.
#
# --nth=-1 matches against the last whitespace field only — the session name,
# which is exactly what `{-1}` already hands ctrl-x — so the prefix stops
# counting. --tiebreak=index then settles genuine ties by input
# order, and list_items emits active sessions first. Together: "dot" gives
# dotfiles then dotstat, "pin" gives pinax then its three siblings.
#
# There is no preview. It had been bound to ctrl-p, which is fzf's own "move
# up" — so turning it on cost the list its navigation, which is worth far more
# than the pane was. It had already been demoted to hidden-by-default because
# 70% of the width clamped the project names and their Claude markers, which is
# what this list is actually read for.
#
# Note the flags below are one backslash-continued command: a comment placed
# between them is joined *into* the command rather than ignored, and `bash -n`
# does not object. That silently swallowed these two flags on the first attempt.
choice=$(
  list_items | fzf \
    --prompt="dev > " \
    --ansi \
    --nth=-1 \
    --tiebreak=index \
    --no-height \
    --layout=reverse \
    --border=rounded \
    --header='ctrl-x: kill session' \
    --bind="ctrl-x:execute-silent(tmux kill-session -t \={-1} 2>/dev/null)+reload($SELF --list)" \
    --info=inline
) || exit 0

# The last field, which is exactly what fzf handed ctrl-x as `{-1}`. Stripping the `● ` prefix alone stopped working once a Claude marker
# could sit between it and the name.
name="${choice##* }"

if tmux has-session -t "=$name" 2>/dev/null; then
  if [[ -n "$TMUX" ]]; then
    tmux switch-client -t "=$name"
  else
    tmux attach -t "=$name"
  fi
else
  new-session "$name" "$(resolve_dir "$name")"
fi
