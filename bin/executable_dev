#!/usr/bin/env bash
# dev - fuzzy-pick an active tmux session or project from ~/dev

# Every tmux -t target below is written "=$name". The leading = forces an exact
# match: without it tmux tries exact, then *prefix*, then fnmatch, so with a
# pinax-ai session running and no pinax session, `has-session -t pinax` answers
# true and switch-client lands in pinax-ai. Real collisions here today are
# pinax against pinax-{ai,harmonization,suite-docs} and sdmxlib against
# sdmxlib-rest. The kill binding matters most: ctrl-x on pinax would otherwise
# kill pinax-ai, silently.
#
# That binding writes the target as \={-1}, and the backslash is load-bearing.
# fzf runs an execute binding through $SHELL — *not* through the shell this
# script is written in, which is why the backslash survived the move to bash;
# tested by launching fzf from bash and having the binding report $0, which came
# back /bin/zsh. fzf substitutes {-1} already single-quoted, so a bare ={-1}
# reaches zsh as ='name', where a leading = is EQUALS expansion (=foo means "the
# path to command foo"). zsh reported "name not found" and tmux never ran, so
# ctrl-x silently stopped killing anything. Double-quoting cannot fix it: fzf
# supplies its own quotes inside, which would end up in the target name. The
# backslash suppresses the expansion and leaves the word as =name.
#
# Written for bash 3.2, the version macOS ships, so /bin/bash runs it. That
# rules out associative arrays and mapfile; see EXTRA_PROJECTS below.
DEV_DIR="$HOME/dev"

# Extra projects outside DEV_DIR, one "name<TAB>path" per line. This is the
# single source of both the names and their paths — bash 3.2 has no
# associative arrays, and two parallel lists would be one more thing to keep
# in step.
EXTRA_PROJECTS="dotfiles	$HOME/.local/share/chezmoi"

extra_names() {
  printf '%s\n' "$EXTRA_PROJECTS" | cut -f1
}

resolve_dir() {
  local name="$1" path
  path=$(printf '%s\n' "$EXTRA_PROJECTS" | awk -F'\t' -v n="$name" '$1 == n { print $2; exit }')
  if [[ -n "$path" ]]; then
    printf '%s\n' "$path"
  else
    printf '%s\n' "$DEV_DIR/$name"
  fi
}

preview() {
  local name="$1"
  local dir
  dir=$(resolve_dir "$name")

  if tmux has-session -t "=$name" 2>/dev/null; then
    echo -e "\033[1;32m● active session\033[0m\n"
    tmux capture-pane -t "=$name" -p -e 2>/dev/null | tail -30
    return
  fi

  echo -e "\033[1;34m── Files ──────────────────────────────\033[0m"
  # eza needs a width for --grid. fzf exports FZF_PREVIEW_COLUMNS, but this
  # script is also runnable by hand, and bash passes an unset variable through
  # as COLUMNS="", which eza reads as no room at all and prints one long line.
  # zsh happened to leave it usable, so the fallback is new here.
  COLUMNS="${FZF_PREVIEW_COLUMNS:-${COLUMNS:-80}}" eza --icons --grid --group-directories-first "$dir" 2>/dev/null | head -20

  if [[ -d "$dir/.git" ]]; then
    echo -e "\n\033[1;34m── Git log ────────────────────────────\033[0m"
    git -C "$dir" log --oneline --color=always -7 2>/dev/null
    local git_status
    git_status=$(git -C "$dir" status --short 2>/dev/null)
    if [[ -n "$git_status" ]]; then
      echo -e "\n\033[1;34m── Git status ─────────────────────────\033[0m"
      echo "$git_status"
    fi
  fi

  if [[ -f "$dir/pyproject.toml" ]]; then
    echo -e "\n\033[1;34m── pyproject.toml ─────────────────────\033[0m"
    bat --color=always --line-range=:25 "$dir/pyproject.toml" 2>/dev/null
  fi
  if [[ -f "$dir/Cargo.toml" ]]; then
    echo -e "\n\033[1;34m── Cargo.toml ─────────────────────────\033[0m"
    bat --color=always --line-range=:25 "$dir/Cargo.toml" 2>/dev/null
  fi
  if [[ -f "$dir/README.md" ]]; then
    echo -e "\n\033[1;34m── README ─────────────────────────────\033[0m"
    bat --color=always --line-range=:20 "$dir/README.md" 2>/dev/null
  fi
}

# Live sessions, most-recently-attached first. Alphabetical order made the list
# stable but made swapping between two sessions a reading exercise: the one you
# just came from sat wherever its name fell. This is the alt-tab ordering — the
# session you were in last is the top entry, so the common case is one keypress.
#
# The current session is pushed to the end of the group rather than dropped. It
# sorts newest by definition, so leaving it in place would park the one session
# you cannot switch to in exactly the slot the cursor starts on; but it is still
# worth showing, not least so ctrl-x can reach it.
#
# session_last_attached is empty for a session that has never had a client. Those
# sort as 0, i.e. last among the active ones, which is the right place for them.
#
# Only this group is reordered. The project list below stays alphabetical: it is
# long and browsed by name, and churn there would cost more than it gave.
active_sessions() {
  local current="" names n
  [[ -n "$TMUX" ]] && current=$(tmux display-message -p '#{session_name}' 2>/dev/null)

  names=$(tmux list-sessions -F "#{session_last_attached}$(printf '\t')#{session_name}" 2>/dev/null |
    sort -t "$(printf '\t')" -k1,1nr | cut -f2)
  [[ -z "$names" ]] && return

  while IFS= read -r n; do
    [[ -n "$n" && "$n" != "$current" ]] && printf '%s\n' "$n"
  done <<<"$names"

  # Re-add the current session last, but only if it really was in the list.
  if [[ -n "$current" ]]; then
    while IFS= read -r n; do
      if [[ "$n" == "$current" ]]; then
        printf '%s\n' "$n"
        break
      fi
    done <<<"$names"
  fi
}

# Is $1 one of the newline-separated names in $2?
is_active() {
  [[ -n "$2" ]] && printf '%s\n' "$2" | grep -qxF -- "$1"
}

list_items() {
  local active s proj
  active=$(active_sessions)

  if [[ -n "$active" ]]; then
    while IFS= read -r s; do
      printf '● %s\n' "$s"
    done <<<"$active"
  fi

  # A glob rather than `ls -1`: same alphabetical order and same set (both skip
  # dotfiles), but nothing has to parse a filename back out of a listing.
  local path
  for path in "$DEV_DIR"/*; do
    [[ -e "$path" ]] || continue
    proj="${path##*/}"
    is_active "$proj" "$active" || printf '%s\n' "$proj"
  done

  extra_names | while IFS= read -r proj; do
    is_active "$proj" "$active" || printf '%s\n' "$proj"
  done
}

if [[ "${1}" == "--preview" ]]; then
  preview "$2"
  exit 0
fi

if [[ "${1}" == "--list" ]]; then
  list_items
  exit 0
fi

SELF="$0"

choice=$(
  list_items | fzf \
    --prompt="dev > " \
    --ansi \
    --preview="$SELF --preview {-1}" \
    --preview-window=right:70% \
    --no-height \
    --layout=reverse \
    --border=rounded \
    --header='ctrl-x: kill session' \
    --bind='ctrl-f:preview-down' \
    --bind='ctrl-b:preview-up' \
    --bind="ctrl-x:execute-silent(tmux kill-session -t \={-1} 2>/dev/null)+reload($SELF --list)" \
    --info=inline
) || exit 0

name="${choice#● }"

if tmux has-session -t "=$name" 2>/dev/null; then
  if [[ -n "$TMUX" ]]; then
    tmux switch-client -t "=$name"
  else
    tmux attach -t "=$name"
  fi
else
  new-session "$name" "$(resolve_dir "$name")"
fi
