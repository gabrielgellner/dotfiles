#!/usr/bin/env zsh
# claude-window - jump to (or create) a `claude` window in the current tmux session.
#
# Bound to prefix + C (see dot_tmux.conf). Claude runs as a normal full-terminal
# session here, not inside nvim, but still gets editor integration: nvim (with
# claudecode.nvim) publishes a WebSocket server in ~/.claude/ide/<port>.lock and
# the CLI finds it by matching the workspace directory.
#
# That matching is why the window is created with the *session* path rather than
# the current pane's path — a pane cd'd into a subdirectory can fail to match.
# Start nvim before claude so the lock file exists; otherwise use `/ide` in the
# CLI to attach afterwards.

session=$(tmux display-message -p '#{session_name}')
dir=$(tmux display-message -p '#{session_path}')

# Already have one? Just go there. Look the index up rather than selecting by
# name: `tmux select-window -t <session>:claude` exits 0 even when no such
# window exists, so its status can't be used to detect one.
index=$(tmux list-windows -t "$session" -F '#{window_index} #{window_name}' |
  awk '$2 == "claude" { print $1; exit }')

if [[ -n "$index" ]]; then
  tmux select-window -t "$session:$index"
  exit 0
fi

tmux new-window -t "$session" -n claude -c "$dir" claude
