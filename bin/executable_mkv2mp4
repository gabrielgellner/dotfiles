#!/usr/bin/env bash

# Remux one or more MKV files to MP4 without re-encoding the video/audio.
# Streams are stream-copied (fast, lossless); subtitles are converted to
# MP4-compatible mov_text so they survive the container change.
#
# Usage:
#   mkv2mp4 input.mkv [input2.mkv ...]
#   mkv2mp4 *.mkv

set -euo pipefail

if [ "$#" -eq 0 ]; then
  echo "usage: mkv2mp4 <file.mkv> [more.mkv ...]" >&2
  exit 1
fi

if ! command -v ffmpeg >/dev/null 2>&1; then
  echo "error: ffmpeg not found on PATH" >&2
  exit 1
fi

for input in "$@"; do
  if [ ! -f "$input" ]; then
    echo "skipping: $input (not a file)" >&2
    continue
  fi

  # zsh's ${input:r} strips the extension from the last path component only.
  # A bare ${input%.*} is not the same thing: given dir.v2/noext it eats the
  # directory and writes dir.mp4. Split first, then strip.
  base="${input##*/}"
  output="${input%"$base"}${base%.*}.mp4"

  if [ -e "$output" ]; then
    echo "skipping: $output already exists" >&2
    continue
  fi

  echo "remuxing: $input -> $output"

  # -map 0        take every stream from the input
  # -c copy       stream-copy audio/video (no re-encode)
  # -c:s mov_text convert subtitles to an MP4-friendly codec
  # image-based subtitles (PGS/VOBSUB) can't go in MP4, so drop them if
  # the copy fails and retry without subtitles.
  if ! ffmpeg -hide_banner -loglevel warning -stats \
        -i "$input" -map 0 -c copy -c:s mov_text "$output"; then
    echo "subtitle conversion failed, retrying without subtitles" >&2
    rm -f "$output"
    ffmpeg -hide_banner -loglevel warning -stats \
      -i "$input" -map 0 -c copy -sn "$output"
  fi
done
